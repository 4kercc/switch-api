# 服务端口与主机监听
PORT=8045
HOST=0.0.0.0

# 是否开启 HTTPS (true/false)
SSL=false

# 域名（可选，配置后可一键申请 ACME SSL 证书）
DOMAIN=

# 管理后台管理员登录凭据 (建议修改为强密码)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
JWT_SECRET=super_secret_jwt_api_gateway_allin_2026

# 系统全局默认 API Key (客户端调用 API 时使用)
API_KEY=sk-allin-gateway-master-key-2026

# 可选上游请求 SOCKS5 代理 (如 socks5://127.0.0.1:40000)
# PROXY=socks5://127.0.0.1:40000
